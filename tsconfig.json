{
  "compilerOptions": {
    "target": "ES2015",
    "module": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Node16",
    "rootDir": "src",
    "types": ["node"],
    "moduleDetection": "auto"
  },
  "include": ["src/**/*"]
}
